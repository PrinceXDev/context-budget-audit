{
  "name": "rote-playoffs-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic demo video for the Rote Playoffs entry - gitlab-mr-gate + gitlab-mr-queue",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
