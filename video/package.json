    "@remotion/transitions": "4.0.394",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.394"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.8.2"
  }
}
